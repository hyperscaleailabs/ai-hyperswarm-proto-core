# hsai runtime
.hsai/
# Raw worker trajectories quote repo content: they stay local (inspect them
# with `hsai traj <iteration>`); only a digest line and a redacted tail are
# committed, inside the lesson and the PR body.
.hsai/traj/
# Raw per-branch event streams (`--output-format stream-json`): same rule, same
# reason. Read one with `hsai replay <branch>`; only its digest is committed.
.hsai/trajectories/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp

# Obsidian: keep shared config, ignore per-user workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
