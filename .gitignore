# hsai runtime
.hsai/
# Raw worker trajectories quote repo content: they stay local (inspect them
# with `hsai traj <iteration>`); only a digest line and a redacted tail are
# committed, inside the lesson and the PR body.
.hsai/traj/
# Per-iteration trajectories, same rule. Deliberately NOT under knowledge/:
# the Obsidian vault is curated and committed, these are raw local telemetry.
# The committed, hand-authored counterpart is tests/fixtures/trajectories/.
.hsai/trajectories/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp

# Obsidian: keep shared config, ignore per-user workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
