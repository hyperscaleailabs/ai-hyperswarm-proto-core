# hsai runtime
.hsai/
# Raw worker trajectories quote repo content: they stay local (replay them with
# `hsai replay <id>`); only a redacted tail is committed, inside the lesson.
.hsai/trajectories/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp

# Obsidian: keep shared config, ignore per-user workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
