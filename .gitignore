# hsai runtime (worktrees, cycle journals). Worker trajectories are NOT here:
# they are audit evidence and live, redacted and size-capped, under
# knowledge/trajectories/ - inspect one with `hsai traj <iteration>`.
.hsai/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp

# Obsidian: keep shared config, ignore per-user workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
